{
  "id": "AH-CTK-030",
  "title": "escalate at pre_tool_call routes to approval resolver; approve\u2192allow proceeds",
  "spec_clause": "9, 6",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "scenario": {
    "input": {
      "content": "send wire",
      "role": "user"
    },
    "tools": [
      {
        "name": "wire_transfer",
        "schema": {
          "amount": "number"
        },
        "behavior": [
          {
            "return": {
              "txn": "tx-1"
            }
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "wire_transfer",
              "args": {
                "amount": 100
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "sent",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_script": [
    {
      "at": "pre_tool_call",
      "match": {
        "tool_call.name": "wire_transfer"
      },
      "return": {
        "decision": "escalate",
        "reason": "ctk:requires_approval"
      }
    }
  ],
  "approval_script": [
    {
      "resolve": {
        "outcome": "approve",
        "verdict": {
          "decision": "allow"
        }
      }
    }
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call",
        "context": {
          "tool_call.name": "wire_transfer"
        }
      },
      {
        "interception_point": "post_tool_call",
        "context": {
          "tool_result.value.txn": "tx-1"
        }
      }
    ],
    "tool_invocations": [
      {
        "name": "wire_transfer",
        "args": {
          "amount": 100
        }
      }
    ],
    "run_outcome": "completed"
  }
}