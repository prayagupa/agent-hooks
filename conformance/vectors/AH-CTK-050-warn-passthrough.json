{
  "id": "AH-CTK-050",
  "title": "warn permits the action and does not modify target",
  "spec_clause": "5.1, 6",
  "level": 2,
  "capabilities": ["model_calls", "tool_calls"],
  "scenario": {
    "input": { "content": "fetch", "role": "user" },
    "tools": [ { "name": "http_get", "behavior": [ { "when_args": { "url": "https://x" }, "return": "ok" }, { "return": "WRONG" } ] } ],
    "model_script": [
      { "respond": { "content": null, "tool_calls": [ { "id": "tc-1", "name": "http_get", "args": { "url": "https://x" } } ], "finish_reason": "tool_calls" } },
      { "respond": { "content": "done", "tool_calls": [], "finish_reason": "stop" } }
    ]
  },
  "interceptor_script": [
    { "at": "pre_tool_call", "return": { "decision": "warn", "reason": "ctk:suspicious", "message": "looks odd" } }
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      { "interception_point": "post_tool_call", "context": { "tool_call.args.url": "https://x", "tool_result.value": "ok" } }
    ],
    "tool_invocations": [ { "name": "http_get", "args": { "url": "https://x" } } ],
    "run_outcome": "completed",
    "identities_equal": true
  }
}
