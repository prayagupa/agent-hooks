{
  "id": "AH-CTK-032",
  "title": "escalate with no registered resolver → deny with hook_error:approval_resolver_missing",
  "spec_clause": "9, 11",
  "level": 2,
  "capabilities": ["model_calls", "tool_calls"],
  "scenario": {
    "input": { "content": "send wire", "role": "user" },
    "tools": [ { "name": "wire_transfer", "behavior": [ { "return": "UNREACHED" } ] } ],
    "model_script": [
      { "respond": { "content": null, "tool_calls": [ { "id": "tc-1", "name": "wire_transfer", "args": {} } ], "finish_reason": "tool_calls" } },
      { "respond": { "content": "could not send", "tool_calls": [], "finish_reason": "stop" } }
    ]
  },
  "consumer_script": [
    { "at": "pre_tool_call", "return": { "decision": "escalate", "reason": "ctk:requires_approval" } }
  ],
  "approval_script": [],
  "expect": {
    "sequence_strict": false,
    "hooks": [ { "hook_point": "pre_tool_call" } ],
    "hooks_absent": ["post_tool_call"],
    "tool_not_invoked": ["wire_transfer"],
    "run_outcome": "completed"
  }
}
