<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ResponsibleAI.AgentHooks</PackageId>
    <Description>Framework-neutral agent control contract (AGENT-HOOKS-0.1). .NET wrapper over the canonical Rust core via libagent_hooks_ffi.</Description>
    <RootNamespace>AgentHooks</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native library resolved at runtime via NativeLibrary search paths.
         Packaging: the release workflow bundles libagent_hooks_ffi per RID
         under runtimes/<rid>/native/. For local dev, set
         LD_LIBRARY_PATH / DYLD_LIBRARY_PATH / PATH to sdk/rust/target/release. -->
  </ItemGroup>
</Project>
