{
  "$id": "https://agent-hooks.responsibleai.dev/v0.1/interception-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks \u2014 interception record",
  "description": "Host-side record of one interception (AGENT-HOOKS-0.1 \u00a76, \u00a710). Identity-only by design: input/enforced identities bind the record to the exact pre/post-fold context without duplicating the payload into audit storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interception_point",
    "mode",
    "verdict",
    "input_identity",
    "enforced_identity"
  ],
  "properties": {
    "interception_point": {
      "$ref": "interception-point.schema.json"
    },
    "mode": {
      "type": "string",
      "enum": [
        "enforce",
        "evaluate_only"
      ]
    },
    "verdict": {
      "$ref": "verdict.schema.json"
    },
    "input_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enforced_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}